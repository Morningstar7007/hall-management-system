<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hallmanagementsystem.ManageStudentsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- LEFT SIDE: Data Entry Form -->
    <VBox prefWidth="300.0" spacing="15.0" style="-fx-border-color: #2E7D32; -fx-border-width: 1; -fx-padding: 20; -fx-background-color: #FAFAFA;">
        <Label text="Register New Student" textFill="#2E7D32">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <VBox spacing="5.0">
            <Label text="Student ID (Roll)" />
            <TextField fx:id="studentIdField" promptText="e.g. 2307099" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Full Name" />
            <TextField fx:id="nameField" promptText="e.g. MONOJIT PAUL TANMAY" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Contact Number" />
            <TextField fx:id="contactField" promptText="e.g. 01550086298" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Assigned Room" />
            <TextField fx:id="roomField" promptText="e.g. B-1462" />
        </VBox>

        <Button maxWidth="Infinity" onAction="#onSaveStudentClick" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;" text="Save Student" />
        <Label fx:id="formStatusLabel" textFill="#D32F2F" wrapText="true" />
    </VBox>

    <!-- RIGHT SIDE: Live Database Table -->
    <VBox HBox.hgrow="ALWAYS" spacing="10.0">
        <Label text="Current Registered Students" textFill="#424242">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="90.0" text="Student ID" />
                <TableColumn fx:id="colName" prefWidth="180.0" text="Full Name" />
                <TableColumn fx:id="colRoom" prefWidth="90.0" text="Room" />
                <TableColumn fx:id="colContact" prefWidth="110.0" text="Contact" />
            </columns>
        </TableView>
    </VBox>
</HBox>