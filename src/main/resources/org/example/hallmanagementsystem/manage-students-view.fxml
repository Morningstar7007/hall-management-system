<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox spacing="15.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hallmanagementsystem.ManageStudentsController">
    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>

    <!-- LEFT SIDE: Data Entry Form (Scrollable) -->
    <VBox prefWidth="350.0" spacing="10.0" style="-fx-border-color: #2E7D32; -fx-border-width: 1; -fx-background-color: #FAFAFA;">
        <padding><Insets bottom="10.0" left="15.0" right="15.0" top="10.0" /></padding>
        <Label text="Manage Student Records" textFill="#2E7D32">
            <font><Font name="System Bold" size="16.0" /></font>
        </Label>

        <Label text="* Indicates a mandatory field" textFill="#D32F2F">
            <font><Font name="System Italic" size="11.0" /></font>
        </Label>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="8.0">
                <TextField fx:id="fId" promptText="Student Roll (ID) *" />
                <TextField fx:id="fName" promptText="Name *" />
                <TextField fx:id="fFather" promptText="Father Name *" />
                <TextField fx:id="fMother" promptText="Mother Name *" />
                <TextField fx:id="fDistrict" promptText="Home District" />
                <TextField fx:id="fAddress" promptText="Address *" />

                <!-- DROPDOWNS -->
                <ComboBox fx:id="fDept" promptText="Department *" maxWidth="Infinity" style="-fx-background-color: #FFFFFF; -fx-border-color: #BDBDBD; -fx-border-radius: 3;"/>
                <ComboBox fx:id="fDegree" promptText="Degree Level" maxWidth="Infinity" style="-fx-background-color: #FFFFFF; -fx-border-color: #BDBDBD; -fx-border-radius: 3;"/>

                <TextField fx:id="fReligion" promptText="Religion" />

                <!-- DROPDOWN -->
                <!-- DROPDOWN -->
                <ComboBox fx:id="fGender" promptText="Gender *" maxWidth="Infinity" style="-fx-background-color: #FFFFFF; -fx-border-color: #BDBDBD; -fx-border-radius: 3;"/>

                <TextField fx:id="fPhone" promptText="Phone No" />
                <TextField fx:id="fMobile" promptText="Mobile No *" />
                <TextField fx:id="fEmail" promptText="Email Address" />
                <TextField fx:id="fRoom" promptText="Room No" />

                <!-- DROPDOWN -->
                <ComboBox fx:id="fBlock" promptText="Block" maxWidth="Infinity" style="-fx-background-color: #FFFFFF; -fx-border-color: #BDBDBD; -fx-border-radius: 3;"/>

                <TextField fx:id="fBoarderNo" promptText="Boarder No *" />
                <TextField fx:id="fBoarderType" promptText="Boarder Type" />
            </VBox>
        </ScrollPane>

        <HBox spacing="10.0">
            <Button onAction="#onSaveClick" style="-fx-background-color: #2E7D32; -fx-text-fill: white;" text="Add" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button onAction="#onUpdateClick" style="-fx-background-color: #1976D2; -fx-text-fill: white;" text="Update" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button onAction="#onDeleteClick" style="-fx-background-color: #D32F2F; -fx-text-fill: white;" text="Delete" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
        <Label fx:id="formStatusLabel" textFill="#D32F2F" wrapText="true" />
    </VBox>

    <!-- RIGHT SIDE: Live Database Table -->
    <VBox HBox.hgrow="ALWAYS" spacing="10.0">
        <HBox alignment="BOTTOM_LEFT" spacing="15.0">
            <Label text="Current Registered Students" textFill="#424242">
                <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <Label text="(Double-click a row to view full profile)" textFill="#1976D2">
                <font><Font name="System Italic" size="12.0" /></font>
            </Label>
        </HBox>

        <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" prefWidth="90.0" text="Student ID" />
                <TableColumn fx:id="colName" prefWidth="150.0" text="Full Name" />
                <TableColumn fx:id="colRoom" prefWidth="70.0" text="Room" />
                <TableColumn fx:id="colMobile" prefWidth="110.0" text="Mobile" />
                <TableColumn fx:id="colDept" prefWidth="80.0" text="Dept" />
                <TableColumn fx:id="colBoarderNo" prefWidth="80.0" text="Boarder No" />
                <TableColumn fx:id="colBoarderType" prefWidth="90.0" text="Boarder Type" />
            </columns>
        </TableView>
    </VBox>
</HBox>