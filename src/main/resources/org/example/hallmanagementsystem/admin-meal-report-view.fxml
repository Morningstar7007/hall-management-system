<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hallmanagementsystem.AdminMealReportController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="🍽️ Meal Report" textFill="#2E7D32">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="Select Date:" />
        <DatePicker fx:id="datePicker" onAction="#onDateSelected" />
        <Button onAction="#onDateSelected" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;" text="Refresh Report" />
    </HBox>

    <TitledPane expanded="false" text="Global Meal Override (e.g., Hall Closure)">
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Label text="From:" />
                <DatePicker fx:id="overrideFromDate" />
                <Label text="To:" />
                <DatePicker fx:id="overrideToDate" />
                <Label text="Status:" />
                <ComboBox fx:id="overrideStatusCombo" prefWidth="100.0" />
                <Button onAction="#onApplyGlobalOverride" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Apply to ALL Students" />
            </HBox>
            <Label fx:id="overrideStatusLabel" />
        </VBox>
    </TitledPane>

    <HBox spacing="20.0">
        <VBox alignment="CENTER" prefHeight="80.0" prefWidth="150.0" style="-fx-background-color: #E8F5E9; -fx-background-radius: 10px; -fx-border-color: #2E7D32; -fx-border-radius: 10px;">
            <Label text="Meals ON" textFill="#2E7D32">
                <font><Font name="System Bold" size="14.0" /></font>
            </Label>
            <Label fx:id="mealsOnLabel" text="0" textFill="#2E7D32">
                <font><Font name="System Bold" size="36.0" /></font>
            </Label>
        </VBox>
        <VBox alignment="CENTER" prefHeight="80.0" prefWidth="150.0" style="-fx-background-color: #FFEBEE; -fx-background-radius: 10px; -fx-border-color: #D32F2F; -fx-border-radius: 10px;">
            <Label text="Meals OFF" textFill="#D32F2F">
                <font><Font name="System Bold" size="14.0" /></font>
            </Label>
            <Label fx:id="mealsOffLabel" text="0" textFill="#D32F2F">
                <font><Font name="System Bold" size="36.0" /></font>
            </Label>
        </VBox>
    </HBox>

    <Label text="Student Meal Status Details" textFill="#424242">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Label>

    <TableView fx:id="mealTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colStudentId" text="Student ID" />
            <TableColumn fx:id="colStudentName" text="Student Name" />
            <TableColumn fx:id="colRoomNumber" text="Room Number" />
            <TableColumn fx:id="colStatus" text="Meal Status" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
