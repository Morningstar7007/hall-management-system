<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hallmanagementsystem.AdminManagePaymentsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="💳 Manage Payments" textFill="#2E7D32">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <HBox spacing="10">
        <Label fx:id="formStatusLabel" textFill="#D32F2F" />
    </HBox>

    <GridPane hgap="15.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        
        <!-- Row 0 -->
        <Label text="Student ID *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="studentIdField" promptText="Enter Student Roll" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        
        <Label text="From Year" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="fromYearField" promptText="YYYY" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <!-- Row 1 -->
        <Label text="From Month" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="fromMonthField" promptText="e.g. January" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="To Year" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="toYearField" promptText="YYYY" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <!-- Row 2 -->
        <Label text="To Month" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="toMonthField" promptText="e.g. June" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Messing Fee" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="messingField" promptText="0.0" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <!-- Row 3 -->
        <Label text="Monthly Feast" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="monthlyFeastField" promptText="0.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Fine" GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <TextField fx:id="fineField" promptText="0.0" GridPane.columnIndex="3" GridPane.rowIndex="3" />

        <!-- Row 4 -->
        <Label text="Generator Fee" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="generatorField" promptText="0.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="Water Supply" GridPane.columnIndex="2" GridPane.rowIndex="4" />
        <TextField fx:id="waterSupplyField" promptText="0.0" GridPane.columnIndex="3" GridPane.rowIndex="4" />

        <!-- Row 5 -->
        <Label text="Miscellaneous" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="miscellaneousField" promptText="0.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
    </GridPane>

    <HBox spacing="10">
        <Button onAction="#onSaveClick" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Add Payment" />
        <Button onAction="#onClearClick" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Clear Form" />
    </HBox>

    <Label text="Recent Payments" textFill="#424242">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Label>

    <TableView fx:id="paymentsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colStudentId" text="Student ID" />
            <TableColumn fx:id="colFrom" text="From" />
            <TableColumn fx:id="colTo" text="To" />
            <TableColumn fx:id="colMessing" text="Messing" />
            <TableColumn fx:id="colFeast" text="Feast" />
            <TableColumn fx:id="colFine" text="Fine" />
            <TableColumn fx:id="colTotal" text="Total Paid" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
