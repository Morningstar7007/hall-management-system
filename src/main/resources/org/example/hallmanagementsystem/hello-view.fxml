<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hallmanagementsystem.HelloController">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #0288D1;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <Label text="Lalan Shah Hall Management System" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                <Label fx:id="timeLabel" text="Time: --:--:--" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </HBox>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #FAFAFA; -fx-border-color: #E0E0E0; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>

            <Label text="Student Menu" textFill="#757575">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" left="5.0" />
                </VBox.margin>
            </Label>

            <Button maxWidth="Infinity" onAction="#onProfileClick" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-text-fill: #1976D2;" text="👤 My Profile" />
            <Button maxWidth="Infinity" onAction="#onMealClick" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-text-fill: #1976D2;" text="🍽 Student Meal On/Off" />
            <Button maxWidth="Infinity" onAction="#onPaymentClick" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-text-fill: #1976D2;" text="💰 Payment Details" />
            <Button maxWidth="Infinity" onAction="#onSettingsClick" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-text-fill: #1976D2;" text="⚙ Change Password" />
            <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
                <Label fx:id="apiDataLabel" text="Daily Tip Loading..." textAlignment="CENTER" textFill="#9e9e9e" wrapText="true">
                    <font>
                        <Font name="System Italic" size="11.0" />
                    </font>
                </Label>
            </VBox>
        </VBox>
    </left>

    <!-- CENTER CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #FFFFFF;" BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="20.0">
                <Label text="Welcome to the Dashboard" textFill="#424242">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label fx:id="statusLabel" text="Select an option from the menu to get started." textFill="#757575" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>