<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hallmanagementsystem.ProfileController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <VBox alignment="CENTER">
        <Label text="My Profile" textFill="#039BE5">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
            <VBox.margin>
                <Insets bottom="15.0" />
            </VBox.margin>
        </Label>
    </VBox>

    <HBox spacing="40.0" style="-fx-border-color: #039BE5; -fx-border-width: 1; -fx-padding: 30;">

        <!-- Placeholder for Photo -->
        <VBox alignment="CENTER" prefHeight="150.0" prefWidth="130.0" style="-fx-border-color: #E0E0E0; -fx-background-color: #FAFAFA;">
            <Label text="Student Photo" textFill="#9E9E9E" />
        </VBox>

        <!-- Profile Details -->
        <GridPane hgap="20.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints minWidth="130.0" />
                <ColumnConstraints minWidth="250.0" />
            </columnConstraints>

            <Label text="Student Roll" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="rollLabel" text=": Loading..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Name" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="nameLabel" text=": Loading..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Department" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label text=": CSE" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Mobile No" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Label fx:id="mobileLabel" text=": Loading..." GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Email Address" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <Label text=": monojitpaul704@gmail.com" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Block" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <Label text=": B" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <Label text="Assigned Room" GridPane.columnIndex="0" GridPane.rowIndex="6" />
            <Label fx:id="roomLabel" text=": Loading..." GridPane.columnIndex="1" GridPane.rowIndex="6" />
        </GridPane>
    </HBox>
</VBox>