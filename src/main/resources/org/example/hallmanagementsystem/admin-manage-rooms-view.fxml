<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hallmanagementsystem.AdminManageRoomsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="🚪 Manage Rooms" textFill="#2E7D32">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <HBox spacing="10">
        <Label fx:id="formStatusLabel" textFill="#D32F2F" />
    </HBox>

    <GridPane hgap="15.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        
        <Label text="Room Number *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="roomNumberField" promptText="e.g. B-1462" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        
        <Label text="Capacity *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="capacityField" promptText="e.g. 2" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    </GridPane>

    <HBox spacing="10">
        <Button onAction="#onSaveClick" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Add Room" />
        <Button onAction="#onUpdateClick" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Update Room" />
        <Button onAction="#onDeleteClick" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Delete Room" />
        <Button onAction="#onClearClick" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Clear Form" />
    </HBox>

    <Label text="Room List" textFill="#424242">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Label>

    <TableView fx:id="roomsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRoomNumber" text="Room Number" />
            <TableColumn fx:id="colCapacity" text="Capacity" />
            <TableColumn fx:id="colOccupancy" text="Current Occupancy" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
