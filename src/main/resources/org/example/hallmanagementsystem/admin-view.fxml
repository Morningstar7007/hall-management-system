<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hallmanagementsystem.AdminController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2E7D32;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <Label text="Hall Management System - ADMIN PANEL" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #FAFAFA; -fx-border-color: #E0E0E0; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>
            <Label text="Admin Menu" textFill="#757575">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <Button maxWidth="Infinity" onAction="#onManageStudentsClick" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-text-fill: #2E7D32;" text="👥 Manage Students" />
            <Button maxWidth="Infinity" onAction="#onLogoutClick" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-text-fill: #D32F2F;" text="🚪 Logout" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #FFFFFF;" BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="20.0">
                <Label text="Welcome to the Admin Dashboard" textFill="#424242">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label fx:id="statusLabel" text="Select an option from the menu." textFill="#757575" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>